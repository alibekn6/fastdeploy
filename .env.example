NEXT_PUBLIC_API_URL=https://api.example.com
# WebSocket endpoint for the /examples/websocket demo. Must be wss:// unless
# the host is localhost (build-time enforced); defaults to wss://api.example.com/ws.
NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
NEXT_PUBLIC_API_MOCKING=disabled
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosted PostHog (leave KEY blank to disable analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://ph.your-domain.example
