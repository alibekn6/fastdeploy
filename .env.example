NEXT_PUBLIC_API_URL=https://api.example.com
# WebSocket endpoint for the /examples/websocket demo. Must be wss:// unless
# the host is localhost (build-time enforced); defaults to wss://api.example.com/ws.
NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
NEXT_PUBLIC_API_MOCKING=disabled
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Real backend (both required together to leave sample-data mode):
# set NEXT_PUBLIC_API_MOCKING=disabled, point NEXT_PUBLIC_API_URL at
# http://localhost:3000/api (or https://<your-domain>/api in prod), and fill:
# DATABASE_URL=            # from `vercel env pull .env.local` after `vercel integration add neon`
# JWT_SECRET=              # generate: openssl rand -base64 48

# Self-hosted PostHog (leave KEY blank to disable analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://ph.your-domain.example
